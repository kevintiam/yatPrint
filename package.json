{
  "name": "yatprint-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site de Yat'Print : personnalisation de vêtements et d'objets, collection maison, devis entreprises et mentorat.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:lines": "node scripts/check-lines.js",
    "verify": "npm run lint && npm run check:lines && npm run test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file=.env scripts/seed.js",
    "db:studio": "prisma studio",
    "admin:create": "node --env-file=.env scripts/create-admin.js"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "vitest": "^5.1.0"
  }
}
