# ------------------------------------------------------------------
# Variables d'environnement du site Yat'Print
# Copiez ce fichier en « .env » puis remplissez les valeurs.
# Le fichier .env n'est JAMAIS envoyé sur GitHub (voir .gitignore).
# ------------------------------------------------------------------

# --- Base de données PostgreSQL (Neon) ---
# 1. Créez un compte gratuit sur https://neon.tech puis un projet « yatprint ».
# 2. Bouton « Connect » : copiez les DEUX adresses proposées.
#
# DATABASE_URL : adresse « pooled » (son nom d'hôte contient « -pooler »).
#   C'est celle qu'utilise le site.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@ep-xxxx-pooler.ca-east-2.aws.neon.tech/neondb?sslmode=verify-full"
# DIRECT_URL : adresse « directe » (sans « -pooler »).
#   Utilisée seulement par Prisma pour créer/modifier les tables (npm run db:migrate).
DIRECT_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@ep-xxxx.ca-east-2.aws.neon.tech/neondb?sslmode=verify-full"

# --- Adresse publique du site (utilisée pour les liens Stripe et les courriels) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Connexion à l'espace admin (Auth.js) ---
# Générez une valeur au hasard avec : npx auth secret   (ou : openssl rand -base64 32)
AUTH_SECRET=""

# Compte admin créé par « npm run db:seed » (ou « npm run admin:create »)
ADMIN_EMAIL="admin@yatprint.ca"
ADMIN_PASSWORD="ChangezCeMotDePasse!2026"
ADMIN_NAME="Gessica"

# --- Paiement Stripe (mode test : clés qui commencent par sk_test_ / whsec_) ---
# Laissez vide pour utiliser le « mode démo » (commande confirmée sans paiement,
# bloqué automatiquement en production).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Courriels ---
# Le site choisit automatiquement, dans cet ordre :
#   1. Gmail   si GMAIL_USER et GMAIL_APP_PASSWORD sont remplis ;
#   2. Resend  si RESEND_API_KEY est rempli ;
#   3. sinon, les courriels s'affichent simplement dans le terminal (développement).
#
# Option 1 — Gmail (le plus simple, aucun nom de domaine requis)
# GMAIL_USER : adresse Gmail de la boutique (les courriels partent de cette adresse).
# GMAIL_APP_PASSWORD : « mot de passe d'application » de 16 caractères, PAS le mot
#   de passe habituel du compte. Pour le créer :
#   a. Activez la validation en deux étapes : https://myaccount.google.com/security
#   b. Créez le mot de passe : https://myaccount.google.com/apppasswords
#   Les espaces affichés par Google peuvent être laissés, ils sont retirés automatiquement.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
#
# Option 2 — Resend (demande un nom de domaine vérifié dans Resend)
# Ignoré si Gmail est configuré.
RESEND_API_KEY=""
EMAIL_FROM="Yat'Print <onboarding@resend.dev>"
# Adresse qui reçoit les alertes (nouvelle commande, devis, mentorat, message)
ADMIN_NOTIFICATION_EMAIL="admin@yatprint.ca"

# Les fichiers téléversés (designs des clients, photos ajoutées dans l'admin)
# sont enregistrés dans le dossier storage/uploads du projet.
